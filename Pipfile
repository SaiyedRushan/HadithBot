[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[packages]
discord = "*"
python-dotenv = "*"
flask = "*"
gunicorn = "*"
aiofiles = "*"
tzdata = "*"
supabase = "*"

[dev-packages]
pytest = "*"
watchdog = "*"
pyflakes = "*"

[scripts]
# Autoreload-on-save (nodemon-style, full-process restart).
# `dev` runs just the bot (the usual case); `dev-server` adds the Flask /health endpoint.
dev = "watchmedo auto-restart --patterns='*.py' --recursive -- python bot.py"
dev-server = "watchmedo auto-restart --patterns='*.py' --recursive -- python server.py"

[requires]
python_version = "3.11"
