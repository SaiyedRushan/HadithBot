# Discord Bot Configuration
# Get your bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# Supabase Configuration
# Get these from your Supabase project settings
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# Daily name match game (game_api.py, activity/). Leave unset to run without it.
# From the Discord developer portal, OAuth2 page of the same application.
# DISCORD_CLIENT_ID=
# DISCORD_CLIENT_SECRET=
# 32+ random characters; signs the game's session tokens. `openssl rand -hex 32`
# ACTIVITY_TOKEN_SECRET=
# Which channels get the daily card: empty = none, * = all, or comma-separated ids
# NAME_MATCH_CHANNELS=
