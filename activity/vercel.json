{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {"source": "/api/:path*", "destination": "https://api.hadithbot.app/api/:path*"},
    {"source": "/(.*)", "destination": "/index.html"}
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors https://*.discordsays.com https://discord.com https://*.discord.com"
        }
      ]
    }
  ]
}
